{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@pages/*": ["./src/pages/*"],
      "@components/*": ["./src/components/*"],
      "@api/*": ["./src/api/*"],
      "@fixtures": ["./src/fixtures/index.ts"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@data/*": ["./src/data/*"],
      "@helpers/*": ["./src/helpers/*"],
      "@utils/*": ["./src/utils/*"],
      "@constants/*": ["./src/constants/*"],
      "@app-types/*": ["./src/types/*"],
      "@shared/*": ["../../shared/*"]
    }
  },
  "include": ["src", "tests", "playwright.config.ts", "../../shared"]
}
