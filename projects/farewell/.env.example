# Copy to .env in this folder (git-ignored). Never point at production.
# Set the variables of ONE environment below; a role with no variables is skipped by auth setup.
API_BASE_URL=

# --- UAT (current target): Microsoft Entra SSO ---------------------------------------
BASE_URL=https://uat-farewell.yomagroup.io
