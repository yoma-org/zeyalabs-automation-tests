# Shared secrets for every app in this repo. Copy to .env here (git-ignored); never commit real values.
# App-specific settings stay in projects/<app>/.env.

# --- Xray Cloud: one API key for the whole Jira site, used by scripts/xray-upload.mjs --app <app> ---
# Jira ⚙ → Marketplace apps → Xray → API Keys → Create API Key (prefer a service account).
# The Jira project per app is in projects/<app>/xray.json. On CI set these as secrets instead.
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
